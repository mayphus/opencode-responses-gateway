{
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "lib": ["ES2024"],
    "types": ["@cloudflare/workers-types"],
    "skipLibCheck": false
  },
  "include": ["worker/**/*.ts"]
}
